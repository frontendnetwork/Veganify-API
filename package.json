{
  "name": "veganify-api",
  "version": "0.5.1",
  "description": "Veganify API",
  "license": "MIT",
  "author": "JokeNetwork, Veganify Contributors",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run smoke:worker",
    "check": "concurrently --names \"lint,typecheck,test\" --prefix-colors \"yellow,blue,green\" \"bun run check:code\" \"bun run check:typecheck\" \"bun run check:test\"",
    "check:code": "bun run lint && bun run format:check",
    "check:test": "bun test --timeout=10000 --reporter=dots --bail",
    "check:typecheck": "tsc --noEmit -p tsconfig.build.json",
    "get:peta": "node .github/scripts/peta-cron.js",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun fmt",
    "prepare": "husky",
    "process:all": "concurrently --names \"vegan,not vegan,maybe vegan\" --prefix-colors \"green,red,yellow\" \"bun run process:vegan\" \"bun run process:notvegan\" \"bun run process:maybenotvegan\"",
    "process:ingredients": "bun scripts/processIngredients.js",
    "process:maybenotvegan": "bun run process:ingredients ../ismaybenotvegan.json",
    "process:notvegan": "bun run process:ingredients ../isnotvegan.json",
    "process:vegan": "bun run process:ingredients ../isvegan.json",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "bun dist/main.js",
    "smoke:worker": "bun scripts/smokeIngredientWorker.js",
    "test": "bun test --timeout=10000 --reporter=dots",
    "test:cov": "bun test --coverage"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.1.0",
    "cheerio": "^1.2.0",
    "deepl": "^1.0.13",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "ini": "^7.0.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "@types/ini": "^4.1.1",
    "@types/jsdom": "^30.0.0",
    "axios": "^1.20.0",
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "oxlint": "^1.93.0",
    "qs": "^6.17.1",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "overrides": {
    "axios": "^1.20.0",
    "flatted": "^3.4.2",
    "handlebars": "^4.7.9",
    "minimatch": "^11.0.1",
    "picomatch": "^4.0.7",
    "undici": "^7.24.0"
  },
  "packageManager": "bun@1.4.4"
}
